[6.676, "o", "\u001b[?25l\u001b[5A\u001b[97D\u001b[0;1m5\u001b[10C5\u001b[9C1\u001b[0m\r\r\n\r\r\n\r\r\n\r\r\n\u001b[78C\u001b[0mEnter\u3067\u30ed\u30fc\u30ab\u30eb\u4fdd\u5b58\u3002\u7a7a\u6b04\u306eEnter\u3067\u691c\u7d22\u3078\u001b[0m\r\r\n\u001b[62C\u001b[0m\u2502\u001b[0m  >                                                                                   \r\u001b[149C\u001b[0m\u2502\u001b[0m\r\r\n\u001b[62C\u001b[0m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[149C\u2518\u001b[0m\r\r\n\u001b[62C\u001b[0m Agent \u2192 Owner / AI proposal / not mastery                                             \r\u001b[149C \u001b[0m\r\r\n\u001b[62C\u001b[0m Offline storage                                                                       \r\u001b[149C \u001b[0m\r\r\n\u001b[62C\u001b[0m\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500|\u001b[0;1m Owner Console / \u5224\u65ad\u3068\u7406\u89e3 \u001b[0m|\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[149C\u2510\u001b[0m\r\r\n\u001b[62C\u001b[0m\u2502\u001b[0mOWNER / \u3042"]
[6.688, "o", "\u306a\u305f\u306e\u6307\u793a\u30fb\u5224\u65ad\u30fb\u7406\u89e3\u30fb\u30e1\u30e2                                               \u001b[0;1m^\r\u001b[149C\u001b[0m\u2502\u001b[0m\r\r\n\u001b[63C\u001b[0m                                       \u001b[46C\u001b[0m \u001b[0m\r\r\n\u001b[63C\u001b[0m\u6307\u793a  Build an offline notes app \u001b[0m\r\r\n\u001b[63C\u001b[0m  {\"req\u001b[Cest\":\"Build an\u001b[Coffline notes app\",\"status\":\"SESSION_ONLY_NOT_EXECUTION\"} \u001b[0m\r\r\n\u001b[64C\u001b[0m                                                                                \u001b[0m\r\r\n\u001b[57C\u001b[0m \u001b[5C\u001b[0m\u6307\u793a  Build an offline notes app \u001b[0m\r\r\n\u001b[57C\u001b[0m \u001b[5C\u001b[0m                                 \u001b[0m\r\r\n\u001b[63C\u001b[0mAI\u306e\u4eee\u5b9a  One device for now \u001b[0m\r\r\n\u001b[63C\u001b[0m  AI fixture assumption,\u001b[3Ct\u001b[Ca human decision. \u001b[0m\r\r\n\u001b[64C\u001b[0m                                              \u001b[0m\r\r\n\u001b[63C\u001b[0m\u6301\u3061\u5e30\u308b\u7406\u89e3  Offline storage \u001b[0m\r\r\n\u001b[63C\u001b[0m  REVIEW candidate: keep a r\u001b[Ccoverable copy before sync. Choose next time if you pref\u001b[0m\r\r\n\u001b[63C\u001b[0mer.                                                                                  \u001b[0m\r\r\n\u001b[63C\u001b[0m    \u001b[0m\r\r\n\u001b[63C\u001b[0m\u672a\u89e3\u6c7a  Multi"]
[6.688, "o", "-device conflicts \u001b[0m\r\r\n\u001b[63C\u001b[0m  Not checked. No r\u001b[Cal test receipt is claimed. \u001b[0m\r\r\n\u001b[64C\u001b[0m                                               \u001b[37C\u001b[0m \u001b[0m\r\r\n\u001b[63C\u001b[0m\u81ea\u5206\u306e\u30e1\u30e2  Offline first: keep my notes on my device. \u001b[30C\u001b[0m \u001b[0m\r\r\n\u001b[63C\u001b[0m                                                                     \u001b[16C\u001b[0m \u001b[0m\r\r\n\u001b[63C\u001b[0mAgent\u5165\u529b\u3067\u9805\u76ee\u540d\u306e\u5148\u982d\u30922\u6587\u5b57\u4ee5\u4e0a\u5165\u529b\u3059\u308b\u3068\u3001\u53c2\u7167\u306e\u5019\u88dc\u3092\u9078\u3079\u307e\u3059\u3002 \u001b[24A\u001b[65D\u001b[0m\u001b[?12l\u001b[?25h"]
