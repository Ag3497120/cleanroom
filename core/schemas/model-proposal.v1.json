{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verantyx:model-proposal:1",
  "title": "ModelProposal v1 — recorded proposals, never an authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "context_revision",
    "response_locale",
    "summary",
    "claims",
    "actions",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "context_revision": {
      "type": "integer",
      "minimum": 0
    },
    "response_locale": {
      "enum": [
        "en",
        "ja",
        "zh-Hans",
        "ko",
        "es"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "claims": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "decision_points": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/decision_point"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "source_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool_id",
        "arguments",
        "reason",
        "source_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "tool_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "arguments": {
          "type": "object",
          "maxProperties": 64,
          "description": "Untrusted proposed arguments. The registered tool schema must validate these separately; valid arguments grant no authority."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "needed_observation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "needed_observation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "decision_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "decision_type",
        "question",
        "options"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "VALUE_DECISION",
            "EMPIRICAL_CLAIM",
            "AUTHORITY_GRANT",
            "IMPLEMENTATION_CHOICE",
            "CAPABILITY_LIMIT"
          ]
        },
        "decision_type": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      }
    }
  }
}
